# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Dockerfile
Dockerfile
.dockerignore

# playwright e2e
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
# 디자인 레퍼런스 작업물 — 타사 사이트 캡처(6.7MB)가 들어 있어 저장소에 올리지 않는다
/.design/

